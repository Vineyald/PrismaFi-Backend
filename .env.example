# Copy to .env and adjust. Never commit .env.

# development | production. Defaults to production when unset (fails closed):
# production disables /api/docs, /api/redoc and /api/openapi.json.
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Postgres credentials used by docker-compose.yml to create the local database
# and to build DATABASE_URL inside containers. Keep the password URL-safe
# (letters, digits, - _ .): it is embedded in a URL without encoding.
POSTGRES_USER=prismafi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prismafi

# Async SQLAlchemy URL (asyncpg driver) for commands run on the host (alembic, scripts).
# Must match the POSTGRES_* values above. Containers override it with host "db".
DATABASE_URL=postgresql+asyncpg://prismafi:change-me@localhost:5432/prismafi

# Redis for cache and the Dramatiq broker. Containers override the host to "redis".
REDIS_URL=redis://localhost:6379/0

# Secret that signs access tokens (HS256), at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Browser origins allowed cross-origin, as a JSON list, e.g. ["https://app.example.com"].
# Keep [] in development: the Angular dev server proxies /api, so requests are same-origin.
CORS_ORIGINS=[]
